      "updated": 1775775204808,
      "link": null,
      "locked": false,
      "text": "The ByteStuffer accumulates codewords into bytes\n    - it stalls one cycle after emitting a 0xFF to emit a 0x00\n    - TODO: currently it stalls one cycle after exceeding 8 accumulated bits\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The ByteStuffer accumulates codewords into bytes\n    - it stalls one cycle after emitting a 0xFF to emit a 0x00\n    - TODO: currently it stalls one cycle after exceeding 8 accumulated bits\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

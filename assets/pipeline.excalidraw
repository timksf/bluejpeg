      "boundElements": null,
      "updated": 1775775020069,
      "link": null,
      "locked": false,
      "text": "Huffman encoding is always single cycle operation\n    - there are in total 8 runtime configurable tables\n    - 4x HUFFVAL for all unique elements of {DC,AC}x{Luma,Chroma}\n    - 4x HUFFBITS for all unique elements of {DC,AC}x{Luma,Chroma}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Huffman encoding is always single cycle operation\n    - there are in total 8 runtime configurable tables\n    - 4x HUFFVAL for all unique elements of {DC,AC}x{Luma,Chroma}\n    - 4x HUFFBITS for all unique elements of {DC,AC}x{Luma,Chroma}",
      "autoResize": true,
      "lineHeight": 1.25

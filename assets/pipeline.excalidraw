      "link": null,
      "locked": false,
      "text": "The FrameWriter takes some fixed amount of time to be ready \nfor actual scan data. This is based on the huffman table entries\nand some more fixed offsets. Usually this initial setup is done before\nany scan data arrives\nScan data itself is simply passed through",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The FrameWriter takes some fixed amount of time to be ready \nfor actual scan data. This is based on the huffman table entries\nand some more fixed offsets. Usually this initial setup is done before\nany scan data arrives\nScan data itself is simply passed through",
      "autoResize": true,
      "lineHeight": 1.25
    },

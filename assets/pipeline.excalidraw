      "versionNonce": 736963793,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775774732372,
      "link": null,
      "locked": false,
      "text": "RLE may stall on zero runs > 16\n    - for each sequence of 16 zeros in such a run, a ZRL symbol is emitted\n    - if the DU does not end in a zero, the final zero stretch is encoded \n        into the following AC value\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RLE may stall on zero runs > 16\n    - for each sequence of 16 zeros in such a run, a ZRL symbol is emitted\n    - if the DU does not end in a zero, the final zero stretch is encoded \n        into the following AC value\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

      "text": "Skewed Buffering",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Skewed Buffering",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cmOY3yGQNfgq4HRs9Gkix",
      "type": "text",
      "x": 1848.356131269108,
      "y": 402.84699551016155,
      "width": 312.60858154296875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1p",
      "roundness": null,
      "seed": 1804991703,
      "version": 1005,
      "versionNonce": 2034286035,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775778698360,
      "link": null,
      "locked": false,
      "text": "Each bank has exactly 1 read port\nand 1 write port.\nSkewed buffering enables:\n    - writing an entire row at once\n    - reading an entire column at once\n=> each element in the same read/write \nunit maps to a different bank",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each bank has exactly 1 read port\nand 1 write port.\nSkewed buffering enables:\n    - writing an entire row at once\n    - reading an entire column at once\n=> each element in the same read/write \nunit maps to a different bank",
      "autoResize": true,
      "lineHeight": 1.25
    },

    {
      "id": "T8SX9_8UOQR-DleIHvuGN",
      "type": "text",
      "x": 893.9543654155493,
      "y": 1066.9914623179288,
      "width": 478.88092041015625,
      "height": 260,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2h",
      "roundness": null,
      "seed": 1120795210,
      "version": 683,
      "versionNonce": 1399754570,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775778611951,
      "link": null,
      "locked": false,
      "text": "In even rows, even columns:\n    (1) store value\n    (2) advance col index and potentially row index\nIn even rows, odd columns:\n    (1) average current with previous pixel\n    (2) write result of (1) into buffer at col_idx/2\nIn odd rows, even columns:\n    (1) store value\n    (2) advance col index and potentially row index\nIn odd rows, odd columns:\n    (1) average current with previous pixel in same row\n    (2) average result of (1) with buffered value at col_idx/2\n    (3) advance column index and potentially row index",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In even rows, even columns:\n    (1) store value\n    (2) advance col index and potentially row index\nIn even rows, odd columns:\n    (1) average current with previous pixel\n    (2) write result of (1) into buffer at col_idx/2\nIn odd rows, even columns:\n    (1) store value\n    (2) advance col index and potentially row index\nIn odd rows, odd columns:\n    (1) average current with previous pixel in same row\n    (2) average result of (1) with buffered value at col_idx/2\n    (3) advance column index and potentially row index",
      "autoResize": true,
      "lineHeight": 1.25
    },

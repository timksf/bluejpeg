# Auto-generated BSV module utilization analysis for mkBlueJPEG
# Generated by bsv_utilization.py

# Filter a report_utilization string to keep only specified sections.
# section_patterns: list of glob patterns to match against section headers
# e.g. {"CLB Logic" "Primitives" "BLOCKRAM"}
proc filter_util_sections {rpt section_patterns} {
    set result {}
    set in_section 0
    set capture 0
    set section_lines {}
    foreach line [split $rpt "\n"] {
        # Detect section header: e.g. "1. CLB Logic" or "1.1 Summary of Registers"
        if {[regexp {^\d+\.\d*\s+(.+)$} $line -> sec_name]} {
            # Flush previous section if captured
            if {$capture && [llength $section_lines] > 0} {
                append result [join $section_lines "\n"]
                append result "\n"
            }
            set section_lines {}
            set capture 0
            set sec_name [string trim $sec_name]
            foreach pat $section_patterns {
                if {[string match -nocase "*${pat}*" $sec_name]} {
                    set capture 1
                    break
                }
            }
        }
        if {$capture} {
            lappend section_lines $line
        }
    }
    # Flush last section
    if {$capture && [llength $section_lines] > 0} {
        append result [join $section_lines "\n"]
        append result "\n"
    }
    return $result
}

